# Environment variables for the alert server (set them in Vercel: Project > Settings > Environment Variables).

# Web Push keys. Generate a pair with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for push services: a mailto: address or an https URL you own
VAPID_SUBJECT=mailto:you@example.com

# Shared secret the schedulers send to /api/check (any long random string)
CRON_SECRET=

# Storage. Added automatically when you connect Upstash Redis from Vercel's Storage tab.
KV_REST_API_URL=
KV_REST_API_TOKEN=
